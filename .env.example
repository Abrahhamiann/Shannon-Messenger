# Reference only; scripts read process environment, not this file.
PGHOST=127.0.0.1
PGPORT=5432
PGDATABASE=shannon_dev
PGUSER=shannon_app
PGPASSWORD=Auditore333
PGSSLMODE=disable
HTTP_ADDR=127.0.0.1:8080
SHANNON_AUTH_AUDIENCE=shannon.local
# Explicit local debug only; native TLS is required otherwise.
SHANNON_ALLOW_INSECURE_LOCAL_AUTH=0
# Set both paths for native HTTPS. Never commit private certificate keys.
TLS_CERT_FILE=
TLS_KEY_FILE=
